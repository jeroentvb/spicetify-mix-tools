{
  "name": "spicetify-mix-tools",
  "version": "0.3.1",
  "author": {
    "name": "jeroentvb",
    "url": "https://github.com/jeroentvb"
  },
  "private": true,
  "scripts": {
    "build": "spicetify-creator",
    "build:local": "spicetify-creator --out=dist --minify",
    "build:prod": "npm run build:local && npm run copy:docs",
    "copy:docs": "copyfiles README.md docs/* dist/",
    "watch": "spicetify-creator --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@jeroentvb/eslint-config-typescript": "^9.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "spicetify-creator": "^1.0.17",
    "typescript": "^6.0.3"
  }
}
